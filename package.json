{
  "name": "arrow-puzzle",
  "version": "1.0.0",
  "description": "Arrow Puzzle — Eitaa Mini App on Cloudflare Pages + D1",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev public",
    "db:create": "wrangler d1 create arrow-puzzle-db",
    "db:migrate:local": "wrangler d1 migrations apply arrow-puzzle-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply arrow-puzzle-db --remote"
  },
  "devDependencies": {
    "wrangler": "^3.78.0"
  }
}
