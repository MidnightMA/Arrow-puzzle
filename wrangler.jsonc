{
  // Arrow Puzzle — Eitaa Mini App
  // Cloudflare Pages + D1 configuration
  "name": "arrow-puzzle",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2024-09-23",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arrow-puzzle-db",
      // Replace <DATABASE_ID> with the ID returned by: npx wrangler d1 create arrow-puzzle-db
      "database_id": "<DATABASE_ID>",
      "migrations_dir": "migrations"
    }
  ]
}
